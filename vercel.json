{
  "builds": [
    { "src": "_router.php", "use": "vercel-php@0.9.0" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "uploads/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|avif|svg|ico|webp))$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/_router.php" }
  ]
}
